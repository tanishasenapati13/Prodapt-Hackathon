# ============================================================
# Environment Variables — AI Resume Screening Assistant
# ============================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI service (Person 2)
FASTAPI_BASE_URL=http://localhost:8001

# Database (Person 3 — PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@host:5432/resume_screening

# PII encryption (Person 3 — Fernet key)
# FERNET_KEY=your-fernet-key-here

# Groq API (Person 2 — only needed if running FastAPI locally)
# GROQ_API_KEY=your-groq-api-key-here
