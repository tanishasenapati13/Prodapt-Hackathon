                                    "});",
                                    "",
                                    "pm.test('Response is valid JSON', function () {",
                                    "    pm.response.to.be.json;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /parse-resume — Invalid resume_id",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"resume_id\": -1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/parse-resume",
                            "host": ["{{base_url}}"],
                            "path": ["parse-resume"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Returns error for invalid ID', function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 404, 422]);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
